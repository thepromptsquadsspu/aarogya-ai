# TriageMed Backend Environment Configuration

# Server Port (default 8000)
PORT=8000

# LLM Providers (All Free-Tier Eligible)
# Primary LLM: Groq (for ultra-fast Llama 3.3 70B extraction & Whisper STT)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Fallback LLM: Google Gemini (automatic 429/timeout retry target)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Database: Supabase (PostgreSQL)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Telephony: Twilio Voice Outbound Emergency Alerting
# Set TWILIO_TEST_MODE=true for safe local development (synthesizes speech without dialing)
TWILIO_TEST_MODE=true
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
